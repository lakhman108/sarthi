# API. Copy to Backend/.env and change JWT_SECRET.
# Restart `node app.js` after edits.

PORT=5000
HOST=http://localhost:5000
FRONTEND_HOST=http://localhost:3000
ENVIRONMENT=development

MONGODB_URI=mongodb://127.0.0.1:27017/sarthi
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-string

# Signup email. Gmail users need an App Password in EMAIL_PASSWORD.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Optional OAuth2 mail. If all three are set, they replace EMAIL_PASSWORD.
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=

# Local MinIO. Create a bucket named sarthi at http://localhost:9001 first.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=sarthi
MINIO_ENDPOINT=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9000
